/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# connect-src 'none' บังคับ NFR-02 / AC-07 ที่ระดับเบราว์เซอร์ — โมดูลไม่มี
# backend อยู่แล้ว การปิด fetch/XHR/WebSocket ทั้งหมดจึงทำให้ "ไฟล์ยอดขาย
# ไม่ออกจากเครื่อง" เป็นสิ่งที่เบราว์เซอร์บังคับ ไม่ใช่แค่คำสัญญาในเอกสาร
# style-src ต้องมี 'unsafe-inline' เพราะ index.html ใช้ style="" 126 จุด
# (ไม่มี <script> inline และไม่มี on* handler เลย script-src จึงเข้มได้เต็มที่)

# ไฟล์ใน assets/ ไม่มี hash ในชื่อ — ห้ามใช้ immutable/max-age ยาว
# เดิมตั้ง max-age=31536000, immutable ทั้งที่ชื่อไฟล์คงที่ ผู้ใช้เดิมจึงค้าง
# JS เก่าคู่กับ index.html ใหม่ได้นานถึงหนึ่งปี และ immutable ทำให้ hard refresh
# ก็ไม่ล้างให้ · must-revalidate ยังได้ 304 ตัวเล็ก ไม่เสียแบนด์วิดท์จริง
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

# ต้องมีทั้ง "/" และ "/index.html" — Cloudflare Pages เทียบกับ path ที่ร้องขอ
# การเข้าหน้าแรกด้วย "/" จะไม่เข้าคู่กับกฎ /index.html
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
